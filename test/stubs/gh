#!/usr/bin/env bash
# gh for hub's tests: logs the call, then replays the last matching stub_gh response.
args=$*
printf 'gh %s\n' "$args" >>"${HUB_TEST_LOG:?HUB_TEST_LOG not set}"
mapfile -t stubs <"${HUB_TEST_GH_STUBS:?HUB_TEST_GH_STUBS not set}"
for ((i = ${#stubs[@]} - 1; i >= 0; i--)); do
  IFS=$'\x1f' read -r pattern stdout status <<<"${stubs[i]}"
  # shellcheck disable=SC2053
  if [[ $args == $pattern ]]; then
    [[ -n $stdout ]] && printf '%b\n' "$stdout"
    exit "${status:-0}"
  fi
done
printf 'gh stub: unexpected call: gh %s\n' "$args" >&2
exit 97
