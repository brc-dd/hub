#!/usr/bin/env bash
# Summary: Run git, with the GitHub commands of hub on top of the GitHub CLI.
# Usage: hub [--noop] [GIT-OPTIONS...] COMMAND [ARGS...]
#
# The dispatcher. A COMMAND with a module in lib/hub/cmd is hub's: hub runs git with the global
# options and a one-off alias that runs hub again, so git itself applies -C, -c, --git-dir and
# the rest. Any other command line goes to git as given. --noop prints the git and gh commands
# that change something instead of running them.

# Up to the hand-over to git this is bash 3.2 code: under alias git=hub every git command runs
# it, whatever bash env finds.

hub_self=${BASH_SOURCE[0]}
[[ $hub_self == */* ]] || hub_self=./$hub_self
while [[ -L $hub_self ]]; do
  hub_link=$(readlink "$hub_self")
  case $hub_link in
    /*) hub_self=$hub_link ;;
    *) hub_self=${hub_self%/*}/$hub_link ;;
  esac
done
[[ $hub_self == /* ]] || hub_self=$PWD/$hub_self
# Not ${hub_self%/*/*}: the directory may be named . or .. (../hub from bin/sub).
HUB_ROOT=${hub_self%/*}/..
HUB_LIB=$HUB_ROOT/lib/hub
export HUB_ROOT HUB_LIB

# hub_require_bash5 : exit 1 unless this is bash 5 or newer.
hub_require_bash5() {
  ((BASH_VERSINFO[0] >= 5)) && return 0
  printf "hub: bash 5 or newer is required for hub's commands (this is bash %s; %s)\n" \
    "$BASH_VERSION" 'on macOS: brew install bash' >&2
  exit 1
}

# hub_refuse_git_is_hub : exit 1 when the first git on PATH is this file.
hub_refuse_git_is_hub() {
  local dir hub_path
  # The appended colon keeps a trailing empty field (the current directory), which read -a drops.
  IFS=: read -r -a hub_path <<<"$PATH:"
  for dir in "${hub_path[@]}"; do
    dir=${dir:-.}
    [[ -f $dir/git && -x $dir/git ]] || continue
    # exec git would run this file again, forever.
    if [[ $dir/git -ef $hub_self ]]; then
      printf 'hub: git on PATH is hub itself: %s (%s)\n' "$dir/git" \
        'install hub under its own name and alias git to it' >&2
      exit 1
    fi
    return 0
  done
}

if [[ ${1-} == --run && -n ${HUB_REEXEC-} ]]; then
  hub_require_bash5
  unset HUB_REEXEC
  shift
  # git runs a ! alias from the top of the work tree and exports the user's subdirectory.
  cd -P -- "./${GIT_PREFIX:-.}" || exit 1
  unset GIT_PREFIX
  # git exports the git directory it found; without GIT_WORK_TREE, git would then take the
  # current directory for the top of the work tree. From a bare repository or a .git directory
  # it also exports GIT_IMPLICIT_WORK_TREE=0, which would leave a clone's hooks and submodules
  # without a work tree. GIT_CONFIG points git config, but no other git command, at another
  # file, so hub would read the repository's settings from a file git push never reads.
  [[ ${HUB_KEEP_GIT_DIR-} == 1 ]] || unset GIT_DIR GIT_IMPLICIT_WORK_TREE
  unset HUB_KEEP_GIT_DIR GIT_CONFIG
  export HUB_COMMAND=${1-}
  shift
  if [[ ! $HUB_COMMAND =~ ^[a-z][a-z0-9-]*$ || ! -f $HUB_LIB/cmd/$HUB_COMMAND.sh ]]; then
    printf 'hub: not a hub command: %s\n' "$HUB_COMMAND" >&2
    exit 1
  fi
  # shellcheck source=lib/hub/core.sh
  source "$HUB_LIB/core.sh"
  # shellcheck source=/dev/null
  source "$HUB_LIB/cmd/$HUB_COMMAND.sh"
  "hub_cmd_${HUB_COMMAND//-/_}" "$@"
  exit
fi

HUB_NOOP=0
hub_keep_git_dir=0
[[ -z ${GIT_DIR+set} ]] || hub_keep_git_dir=1
hub_globals=()
unset hub_word
while (($#)); do
  case $1 in
    --noop) HUB_NOOP=1 ;;
    -C | -c | --config-env | --git-dir | --work-tree | --namespace | --attr-source | \
      --super-prefix | --shallow-file)
      [[ $1 != --git-dir ]] || hub_keep_git_dir=1
      hub_globals+=("$1")
      shift
      (($#)) || break
      hub_globals+=("$1")
      ;;
    --git-dir=* | --bare)
      hub_keep_git_dir=1
      hub_globals+=("$1")
      ;;
    --version | -v | --help | -h | [!-]* | '')
      hub_word=$1
      shift
      break
      ;;
    *) hub_globals+=("$1") ;;
  esac
  shift
done

case ${hub_word-} in
  --version | -v) hub_name=version ;;
  --help | -h) hub_name=help ;;
  *) hub_name=${hub_word-} ;;
esac

if [[ -z ${hub_word+set} || ! $hub_name =~ ^[a-z][a-z0-9-]*$ ]] \
  || [[ ! -f $HUB_LIB/cmd/$hub_name.sh ]]; then
  set -- "${hub_globals[@]}" ${hub_word+"$hub_word"} "$@"
  if ((HUB_NOOP)); then
    printf -v hub_line '%q ' git "$@"
    printf '%s\n' "${hub_line% }"
    exit 0
  fi
  hub_refuse_git_is_hub
  exec git "$@"
fi

hub_require_bash5
hub_refuse_git_is_hub
export HUB_REEXEC=1 HUB_NOOP HUB_KEEP_GIT_DIR=$hub_keep_git_dir
exec git "${hub_globals[@]}" -c "alias.hub-run=!exec '${hub_self//\'/\'\\\'\'}' --run" \
  hub-run "$hub_name" "$@"
