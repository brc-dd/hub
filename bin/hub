#!/usr/bin/env bash
# hub — git + GitHub, powered by gh. Safe to alias as git: eval "$(hub alias -s)"
#
#   hub <name> ...   lib/hub/cmd/<name>.sh or lib/hub/ext/<name>.sh handles it
#   anything else    exec git "$@" (nothing is loaded)
#
# Leading options: --noop prints the git/gh commands instead of running them; -C, -c,
# --config-env and git's other global options are honored and forwarded.

if ((BASH_VERSINFO[0] < 5)); then
  printf 'hub: bash 5 or newer is required, but this is bash %s.\n' "$BASH_VERSION" >&2
  printf 'hub: on macOS, install it with Homebrew (brew install bash) and put it first in PATH.\n' >&2
  exit 1
fi

set -o pipefail

# Locate the installation, following symlinks (e.g. /opt/homebrew/bin/hub -> ../Cellar/...).
hub_self=${BASH_SOURCE[0]}
while [[ -L $hub_self ]]; do
  hub_link=$(readlink "$hub_self")
  if [[ $hub_link != /* ]]; then
    hub_dir=${hub_self%/*}
    [[ $hub_dir == "$hub_self" ]] && hub_dir=.
    hub_link=$hub_dir/$hub_link
  fi
  hub_self=$hub_link
done
# no subshells here: this runs on every git invocation
hub_dir=${hub_self%/*}
[[ $hub_dir == "$hub_self" ]] && hub_dir=.
[[ $hub_dir == /* ]] || hub_dir=$PWD/$hub_dir
hub_dir=${hub_dir//\/.\//\/}
hub_dir=${hub_dir%/.}
HUB_ROOT=${hub_dir%/*} # strip the trailing /bin
HUB_LIB=${HUB_LIB:-$HUB_ROOT/lib/hub}
export HUB_ROOT HUB_LIB

HUB_NOOP=${HUB_NOOP:-0}
HUB_GIT_OPTS=() # git global options to forward on every git invocation
hub_cmd=

# gh runs git itself without hub's -c flags, so they are mirrored into the environment of
# hub's gh calls only (HUB_GH_ENV); git called by hub gets the flags and nothing twice.
HUB_GH_ENV=()
hub_gh_env_count=${GIT_CONFIG_COUNT:-0}
hub_config_mirror() { # KEY[=VALUE]
  local key=${1%%=*} value=${1#*=}
  [[ $1 == *=* ]] || value=true
  HUB_GH_ENV+=("GIT_CONFIG_KEY_$hub_gh_env_count=$key" "GIT_CONFIG_VALUE_$hub_gh_env_count=$value")
  hub_gh_env_count=$((hub_gh_env_count + 1))
  HUB_GH_ENV+=("GIT_CONFIG_COUNT=$hub_gh_env_count")
}
hub_config_mirror_env() { # KEY=ENVVAR
  local key=${1%%=*} var=${1#*=} value
  if [[ $1 != *=* || -z $key || -z $var ]]; then
    printf 'fatal: invalid config format: %s\n' "$1" >&2
    exit 128
  fi
  if ! value=$(printenv -- "$var"); then
    printf "fatal: missing environment variable '%s' for configuration '%s'\n" "$var" "$key" >&2
    exit 128
  fi
  hub_config_mirror "$key=$value"
}

while (($#)); do
  case $1 in
    --noop)
      HUB_NOOP=1
      shift
      ;;
    --version | -v)
      hub_cmd=version
      shift
      break
      ;;
    --help | -h)
      hub_cmd=help
      shift
      break
      ;;
    -C)
      (($# >= 2)) || break
      if [[ -n $2 ]]; then cd -- "$2" || exit 1; fi # git -C '' is a no-op too
      shift 2
      ;;
    -c | --config-env | --git-dir | --work-tree | --namespace | --attr-source)
      (($# >= 2)) || break
      HUB_GIT_OPTS+=("$1" "$2")
      case $1 in
        -c) hub_config_mirror "$2" ;;
        --config-env) hub_config_mirror_env "$2" ;;
        --git-dir) HUB_GH_ENV+=("GIT_DIR=$2") ;;
        --work-tree) HUB_GH_ENV+=("GIT_WORK_TREE=$2") ;;
        --namespace) HUB_GH_ENV+=("GIT_NAMESPACE=$2") ;;
      esac
      shift 2
      ;;
    --config-env=* | --git-dir=* | --work-tree=* | --namespace=*)
      HUB_GIT_OPTS+=("$1")
      case $1 in
        --config-env=*) hub_config_mirror_env "${1#--config-env=}" ;;
        --git-dir=*) HUB_GH_ENV+=("GIT_DIR=${1#--git-dir=}") ;;
        --work-tree=*) HUB_GH_ENV+=("GIT_WORK_TREE=${1#--work-tree=}") ;;
        --namespace=*) HUB_GH_ENV+=("GIT_NAMESPACE=${1#--namespace=}") ;;
      esac
      shift
      ;;
    --exec-path=* | --attr-source=* | --list-cmds=*)
      HUB_GIT_OPTS+=("$1")
      shift
      ;;
    -p | --paginate | -P | --no-pager | --no-replace-objects | --no-lazy-fetch | --no-optional-locks | --no-advice | --bare | --literal-pathspecs | --glob-pathspecs | --noglob-pathspecs | --icase-pathspecs)
      HUB_GIT_OPTS+=("$1")
      shift
      ;;
    -*) break ;; # an option we don't know: let git deal with everything
    *)
      hub_cmd=$1
      shift
      break
      ;;
  esac
done

hub_kind=
if [[ $hub_cmd =~ ^[a-z][a-z0-9-]*$ ]]; then
  if [[ -f $HUB_LIB/cmd/$hub_cmd.sh ]]; then
    hub_kind=cmd
  elif [[ -f $HUB_LIB/ext/$hub_cmd.sh ]]; then
    hub_kind=ext
  fi
fi
if [[ -z $hub_kind ]]; then
  if ((HUB_NOOP)); then
    hub_out=git
    for hub_arg in "${HUB_GIT_OPTS[@]}" ${hub_cmd:+"$hub_cmd"} "$@"; do
      if [[ $hub_arg =~ ^[A-Za-z0-9_./:@%+=,^~-]+$ ]]; then hub_out+=" $hub_arg"; else hub_out+=" $(printf '%q' "$hub_arg")"; fi
    done
    printf '%s\n' "$hub_out"
    exit 0
  fi
  exec git "${HUB_GIT_OPTS[@]}" ${hub_cmd:+"$hub_cmd"} "$@"
fi

# shellcheck source=lib/hub/core.sh
source "$HUB_LIB/core.sh"
hub::find_git
# shellcheck source=/dev/null
source "$HUB_LIB/$hub_kind/$hub_cmd.sh"
hub_fn="hub_${hub_kind}_${hub_cmd//-/_}"
declare -F "$hub_fn" >/dev/null || hub::die "hub: $HUB_LIB/$hub_kind/$hub_cmd.sh does not define $hub_fn()"
"$hub_fn" "$@"
