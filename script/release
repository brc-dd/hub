#!/usr/bin/env bash
# Usage: script/release [--dry-run] [VERSION]
#
# Releases hub from a clean main that is up to date with origin: make check,
# script/bump VERSION, push main and the tag, create the GitHub release unless
# it exists, and point Formula/hub.rb at it (not for pre-releases). Without
# VERSION, HEAD must be at the tag named by the VERSION file; after a failure,
# fix it and run script/release again.
#
# Options:
#   -n, --dry-run   run the checks and print the commands instead of running them
#   -h, --help      show this help
set -euo pipefail

die() {
  printf 'script/release: %s\n' "$*" >&2
  exit 1
}
step() { printf '==> %s\n' "$*"; }
run() { if ((dry_run)); then echo "[dry-run]$(printf ' %q' "$@")"; else "$@"; fi; }

dry_run=0 version=
for arg; do
  case $arg in
    -n | --dry-run) dry_run=1 ;;
    -h | --help) exec sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0" ;;
    -*) die "unknown option: $arg" ;;
    *) version=${arg#v} ;;
  esac
done

cd "$(dirname "$0")/.."
[[ $(git symbolic-ref --quiet --short HEAD) == main ]] || die "check out main first"
[[ -z $(git status --porcelain) ]] || die "the working tree is not clean (git status)"
repo=$(git remote get-url origin)
run git fetch --quiet origin
git merge-base --is-ancestor origin/main HEAD || die "main is behind origin/main; pull first"
[[ -z $version ]] || script/bump --dry-run "$version" >/dev/null # fail before make check

step "Checking"
run make check

if [[ -n $version ]]; then
  step "Bumping to $version"
  run script/bump "$version"
else
  version=$(<VERSION)
  [[ $(git rev-parse --quiet --verify "refs/tags/v$version^{commit}") == "$(git rev-parse HEAD)" ]] \
    || die "HEAD is not at v$version; to release a new version: script/release X.Y.Z"
fi
tag=v$version

step "Pushing main and $tag"
run git push origin main --follow-tags

step "Publishing the GitHub release $tag"
create=(gh release create "$tag" --repo "$repo" --verify-tag --generate-notes --title "hub $version")
[[ $version != *-* ]] || create+=(--prerelease)
if ((dry_run)); then
  run "${create[@]}"
elif ! gh release view "$tag" --repo "$repo" >/dev/null 2>&1; then
  # The release workflow that the tag push started may have created it first.
  "${create[@]}" || gh release view "$tag" --repo "$repo" >/dev/null
fi

if [[ $version == *-* ]]; then
  step "Leaving Formula/hub.rb alone: $tag is a pre-release"
else
  step "Pointing Formula/hub.rb at $tag"
  run script/update-formula "$tag"
  if ((dry_run)) || ! git diff --quiet -- Formula/hub.rb; then
    run git commit --quiet -m "Formula: hub $tag" -- Formula/hub.rb
    # The release workflow may have pushed the same formula commit first.
    run git push origin main || { git pull --rebase origin main && git push origin main; }
  fi
fi
((dry_run)) || step "Released hub $version"
