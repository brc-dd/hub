#!/usr/bin/env bash
# Usage: script/bump [--dry-run] [--sign] VERSION
#
# Bumps hub to VERSION (X.Y.Z or X.Y.Z-PRE) on a clean main: writes the VERSION
# file, moves the notes under "## Unreleased" in CHANGELOG.md under a new
# "## vVERSION — YYYY-MM-DD" heading, commits "hub vVERSION" and adds the
# annotated tag vVERSION. Nothing is pushed; script/release does that.
#
# Options:
#   -n, --dry-run   show the CHANGELOG.md change and the git commands, change nothing
#   -s, --sign      make a signed tag (git tag -s)
#   -h, --help      show this help
set -euo pipefail

semver='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$'
die() {
  printf 'script/bump: %s\n' "$*" >&2
  exit 1
}
run() { if ((dry_run)); then echo "[dry-run]$(printf ' %q' "$@")"; else "$@"; fi; }

dry_run=0 tag_type=-a version=
for arg; do
  case $arg in
    -n | --dry-run) dry_run=1 ;;
    -s | --sign) tag_type=-s ;;
    -h | --help) exec sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0" ;;
    -*) die "unknown option: $arg" ;;
    *) version=${arg#v} ;;
  esac
done
[[ $version =~ $semver ]] || die "usage: script/bump [--dry-run] [--sign] X.Y.Z[-PRE]"
tag=v$version

cd "$(dirname "$0")/.."
[[ $(git symbolic-ref --quiet --short HEAD) == main ]] || die "check out main first"
[[ -z $(git status --porcelain) ]] || die "the working tree is not clean (git status)"
if git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null; then die "tag $tag already exists"; fi

changelog=$(awk -v heading="## $tag — $(date +%Y-%m-%d)" '
  !found && /^## Unreleased[ \t]*$/ { print; print ""; print heading; found = lead = 1; next }
  lead && /^[ \t]*$/ { next }
  lead && /^## / { exit }
  lead { print ""; lead = 0 }
  { print }
  END { exit !found || lead }
' CHANGELOG.md) || die "CHANGELOG.md has no notes under '## Unreleased'"

if ((dry_run)); then
  printf '[dry-run] VERSION: %s -> %s\n' "$(<VERSION)" "$version"
  diff -u CHANGELOG.md - <<<"$changelog" || true
else
  printf '%s\n' "$version" >VERSION
  printf '%s\n' "$changelog" >CHANGELOG.md
fi
run git add VERSION CHANGELOG.md
run git commit -m "hub $tag"
run git tag "$tag_type" "$tag" -m "hub $tag"
