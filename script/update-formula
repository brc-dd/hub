#!/usr/bin/env bash
# Usage: script/update-formula [--sha256=HEX] [--dry-run] [--force] vX.Y.Z
#        script/update-formula --self-test
#
# Points the url and sha256 lines of Formula/hub.rb at the source tarball of tag
# vX.Y.Z of REPO (set in the formula), downloading it for the checksum. It
# refuses to go back to an older version (by SemVer precedence) without --force.
#
# Options:
#       --sha256=HEX   use this checksum instead of downloading the tarball
#   -n, --dry-run      show the change instead of writing it
#   -f, --force        point the formula at vX.Y.Z even when it names a newer version
#       --self-test    check the version comparison against known orderings
#   -h, --help         show this help
set -euo pipefail

formula=Formula/hub.rb
semver='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$'
die() {
  printf 'script/update-formula: %s\n' "$*" >&2
  exit 1
}

# version_lt A B : X.Y.Z[-PRE] version A has lower precedence than B (SemVer 2.0.0)
version_lt() {
  local LC_ALL=C a=${1/-/.} b=${2/-/.} i x y num='^[0-9]+$'
  # A release ends in "~", which sorts above any pre-release identifier.
  [[ $1 == *-* ]] || a+=.~
  [[ $2 == *-* ]] || b+=.~
  IFS=. read -ra a <<<"$a"
  IFS=. read -ra b <<<"$b"
  for ((i = 0; i < ${#a[@]} && i < ${#b[@]}; i++)); do
    x=${a[i]} y=${b[i]}
    [[ $x != "$y" ]] || continue
    # Numbers (of any length) sort below other identifiers, which sort in ASCII order.
    if [[ $x =~ $num ]]; then
      [[ ! $y =~ $num ]] || ((${#x} < ${#y})) || [[ ${#x} -eq ${#y} && $x < "$y" ]]
    else
      [[ ! $y =~ $num && $x < "$y" ]]
    fi
    return
  done
  ((${#a[@]} < ${#b[@]}))
}

# Each line is in ascending order; the first one is SemVer 2.0.0's own example.
self_test() {
  local line v i j
  for line in \
    '1.0.0-alpha 1.0.0-alpha.1 1.0.0-alpha.beta 1.0.0-beta 1.0.0-beta.2 1.0.0-beta.11 1.0.0-rc.1 1.0.0' \
    '1.0.0 1.0.1 1.9.0 1.10.0 2.0.0-0 2.0.0 10.0.0' \
    '1.0.0-2 1.0.0-10 1.0.0-99999999999999999999 1.0.0-100000000000000000000 1.0.0-1a 1.0.0-Alpha 1.0.0-a-b 1.0.0-a0 1.0.0-alpha'; do
    read -ra v <<<"$line"
    for ((i = 0; i < ${#v[@]}; i++)); do
      [[ ${v[i]} =~ $semver ]] || die "not a version: ${v[i]}"
      for ((j = 0; j < ${#v[@]}; j++)); do
        if version_lt "${v[i]}" "${v[j]}"; then ((i < j)); else ((i >= j)); fi \
          || die "wrong order: ${v[i]} and ${v[j]}"
      done
    done
  done
  echo "The version order is right."
}

dry_run=0 force=0 sha256='' tag=''
for arg; do
  case $arg in
    --sha256=*) sha256=${arg#*=} ;;
    -n | --dry-run) dry_run=1 ;;
    -f | --force) force=1 ;;
    --self-test) self_test && exit ;;
    -h | --help) exec sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0" ;;
    -*) die "unknown option: $arg" ;;
    *) tag=v${arg#v} ;;
  esac
done
[[ ${tag#v} =~ $semver ]] || die "usage: script/update-formula [--sha256=HEX] [--dry-run] [--force] vX.Y.Z"
[[ -z $sha256 || $sha256 =~ ^[0-9a-f]{64}$ ]] || die "not a SHA-256 (64 lowercase hex digits): $sha256"

cd "$(dirname "$0")/.."
current=$(sed -n 's#^ *url ".*/v\([^/]*\)\.tar\.gz"$#\1#p' "$formula")
if ((! force)) && [[ $current =~ $semver ]] && version_lt "${tag#v}" "$current"; then
  die "$formula points at v$current, which is newer than $tag (--force to go back)"
fi
if [[ -z $sha256 ]]; then
  repo=$(sed -n 's/^ *REPO = "\([^"]*\)".*/\1/p' "$formula")
  url=https://github.com/$repo/archive/refs/tags/$tag.tar.gz
  echo "Downloading $url" >&2
  sha256=$(curl -fsSL --retry 3 "$url" | shasum -a 256) || die "could not download $url"
  sha256=${sha256%% *}
fi

# Replace the quoted values of the first url and sha256 lines.
new=$(awk -v url="https://github.com/#{REPO}/archive/refs/tags/$tag.tar.gz" -v sha256="$sha256" '
  !u && /^ *url "/ { sub(/"[^"]*"/, "\"" url "\""); u = 1 }
  !s && /^ *sha256 "/ { sub(/"[^"]*"/, "\"" sha256 "\""); s = 1 }
  { print }
  END { exit !(u && s) }
' "$formula") || die "$formula has no url or sha256 line"
if ((dry_run)); then
  diff -u "$formula" - <<<"$new" || true
else
  printf '%s\n' "$new" >"$formula"
  echo "Pointed $formula at $tag (sha256 $sha256)"
fi
