root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# shfmt reads these keys (https://github.com/mvdan/sh#shfmt)
[*.{sh,bash}]
shell_variant = bash
switch_case_indent = true
binary_next_line = true
space_redirects = false

[{bin/hub,test/stubs/gh,script/*}]
shell_variant = bash
switch_case_indent = true
binary_next_line = true
space_redirects = false

[*.bats]
shell_variant = bats
switch_case_indent = true
binary_next_line = true
space_redirects = false
